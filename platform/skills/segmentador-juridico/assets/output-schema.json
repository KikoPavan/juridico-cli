{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://juridico-cli/schemas/segmentador-juridico/v1.1.0",
  "title": "SegmentadorJuridico_Output",
  "description": "Schema de saída da skill segmentador-jurídico — Envelope de Processo (juridico-cli pipeline v1.1.0)",
  "type": "object",
  "required": ["metadata", "pecas"],
  "additionalProperties": false,

  "properties": {

    "metadata": {
      "type": "object",
      "description": "Metadados do envelope de processo.",
      "required": ["processo_id", "total_pecas", "gerado_por", "timestamp", "source_file", "total_pages", "schema_version"],
      "additionalProperties": false,
      "properties": {
        "processo_id": {
          "type": "string",
          "description": "Identificador único do processo (ex: 1234567-89.2025.8.26.0000)."
        },
        "total_pecas": {
          "type": "integer",
          "minimum": 1,
          "description": "Número de peças lógicas identificadas."
        },
        "gerado_por": {
          "type": "string",
          "const": "segmentador-juridico",
          "description": "Skill que gerou este envelope. Sempre 'segmentador-juridico'."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp ISO 8601 da execução da segmentação."
        },
        "source_file": {
          "type": "string",
          "description": "Nome ou caminho do arquivo de origem (PDF ou Markdown limpo)."
        },
        "total_pages": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Total de páginas do documento. Null se não detectável."
        },
        "ocr_quality": {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown"],
          "description": "Qualidade estimada do OCR do documento de origem."
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Versão do schema (semver). Atual: 1.1.0."
        }
      }
    },

    "pecas": {
      "type": "array",
      "description": "Lista de peças lógicas identificadas no documento.",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Peca"
      }
    }
  },

  "definitions": {
    "Anchor": {
      "type": "object",
      "description": "Uma âncora textual/de página que justifica delimitação da peça.",
      "required": ["label", "page"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador legível da âncora (ex: 'cabecalho', 'pedidos', 'DESPACHO')."
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "description": "Página onde a âncora ocorre."
        }
      }
    },

    "Flags": {
      "type": "object",
      "description": "Flags booleanas de metadados jurídicos.",
      "additionalProperties": true,
      "properties": {
        "prova_documental": { "type": "boolean", "default": false },
        "decisao_judicial": { "type": "boolean", "default": false },
        "representacao_processual": { "type": "boolean", "default": false },
        "duplicata_suspeita": { "type": "boolean", "default": false },
        "prazo_expirado": { "type": "boolean", "default": false }
      }
    },

    "Peca": {
      "type": "object",
      "description": "Uma peça lógica identificada no documento jurídico.",
      "required": [
        "piece_id",
        "document_type",
        "document_type_confidence",
        "pages_start",
        "pages_end",
        "pages_total",
        "title",
        "summary",
        "impacto_sentenca_proposto",
        "text_excerpt",
        "text",
        "anchors",
        "source_file",
        "source_path",
        "source_sha256",
        "process_group_id",
        "origin_piece_index",
        "relevancia_estimada"
      ],
      "additionalProperties": false,
      "properties": {

        "piece_id": {
          "type": "string",
          "pattern": "^peca_\\d{3}([a-z])?$",
          "description": "Identificador único da peça. Formato: peca_001, peca_002, peca_002a (filha).",
          "examples": ["peca_001", "peca_002", "peca_003a"]
        },

        "document_type": {
          "type": "string",
          "enum": [
            "peticao_inicial",
            "contestacao",
            "replica",
            "decisao_interlocutoria",
            "sentenca",
            "acordao",
            "despacho",
            "procuracao",
            "mandato",
            "contrato",
            "escritura",
            "laudo_pericial",
            "parecer",
            "recurso",
            "agravo",
            "apelacao",
            "embargos_declaracao",
            "impugnacao",
            "memoriais",
            "certidao",
            "ata",
            "oficio",
            "intimacao",
            "citacao",
            "mandado",
            "termo",
            "anexo",
            "comprovante",
            "nao_classificado"
          ],
          "description": "Tipo jurídico da peça identificada."
        },

        "document_type_confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Confiança na classificação. high=2+ sinais primários; medium=1 primário+secundário; low=só secundários."
        },

        "pages_start": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Número da página de início da peça (inclusive). Null se indeterminável."
        },

        "pages_end": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Número da página de fim da peça (inclusive). Null se indeterminável."
        },

        "pages_total": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Total de páginas da peça. pages_end - pages_start + 1. Null se qualquer extremo null."
        },

        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Título inferido ou extraído da peça."
        },

        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Resumo funcional da peça (1-3 frases)."
        },

        "impacto_sentenca_proposto": {
          "type": ["string", "null"],
          "maxLength": 500,
          "description": "Avaliação sumária do impacto potencial na sentença. Null se não aplicável."
        },

        "text_excerpt": {
          "type": "string",
          "minLength": 1,
          "description": "Trecho textual inicial da peça (~200 caracteres após a âncora de início)."
        },

        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Texto COMPLETO da peça (todo o conteúdo entre fronteiras)."
        },

        "anchors": {
          "type": "array",
          "description": "Lista de âncoras que justificam a delimitação da peça.",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Anchor"
          }
        },

        "observacoes": {
          "type": ["string", "null"],
          "maxLength": 500,
          "description": "Observações de auditoria: ambiguidades, OCR ruim, fallback. Null se nenhuma."
        },

        "source_file": {
          "type": "string",
          "description": "Nome do arquivo de origem (herdado de metadata.source_file)."
        },

        "source_path": {
          "type": "string",
          "description": "Caminho absoluto do arquivo de origem."
        },

        "source_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "description": "Hash SHA-256 hex do arquivo de origem."
        },

        "process_group_id": {
          "type": "string",
          "description": "ID do grupo processual."
        },

        "origin_piece_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Índice ordinal da peça no documento original."
        },

        "relevancia_estimada": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Score de relevância estimado pelo segmentador (0.0–1.0)."
        },

        "confianca_classificacao": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Confiança do segmentador na classificação do tipo documental."
        },

        "sinais_relevancia": {
          "type": "array",
          "description": "Sinais que indicam relevância da peça.",
          "items": { "type": "string" },
          "examples": [["prova_documental", "fundamentacao_legal", "objeto_processual"]]
        },

        "flags": {
          "$ref": "#/definitions/Flags"
        },

        "data_documento": {
          "type": ["string", "null"],
          "format": "date",
          "description": "Data do documento, se identificável."
        },

        "autor": {
          "type": ["string", "null"],
          "description": "Autor ou subscritor da peça, se identificável."
        }
      }
    }
  }
}
