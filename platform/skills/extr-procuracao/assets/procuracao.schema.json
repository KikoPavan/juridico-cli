{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juridico-cli.local/schemas/procuracao.schema.json",
  "title": "procuracao — v3.1 (v0-content + metacampos)",
  "description": "Procuração 1:1 com campos compatíveis com o conteúdo do v0 + metacampos. Campos obrigatórios não podem ficar vazios; sem inferências.",
  "type": "object",
  "required": [
    "document_type",
    "arquivo_origem",
    "schema_utilizado",
    "status",
    "tipo_evidencia",
    "origem",
    "tipo_documento",
    "data_outorga",
    "outorgantes",
    "outorgados",
    "transfere_poderes_pj",
    "transfere_poderes_pf",
    "descricao_poderes",
    "poderes_especificos",
    "fonte"
  ],
  "properties": {
    "document_type": { "const": "procuracao" },

    "arquivo_origem": {
      "type": "string",
      "description": "Nome do arquivo de entrada (.md), sem caminho.",
      "minLength": 1,
      "pattern": "^[^/\\\\]+\\.md$",
      "not": { "const": "collector-proc.md" }
    },

    "schema_utilizado": {
      "type": "string",
      "description": "Identificador do schema utilizado.",
      "minLength": 1
    },

    "status": {
      "type": "string",
      "enum": ["sucesso", "falha"]
    },

    "tipo_evidencia": {
      "type": "string",
      "enum": ["juntada", "processo"]
    },

    "origem": {
      "type": "string",
      "enum": ["juntada", "processo"]
    },

    "tipo_documento": {
      "type": "string",
      "description": "Tipo humano do documento (ex.: 'Procuração').",
      "minLength": 1,
      "maxLength": 200
    },

    "data_outorga": {
      "type": "string",
      "description": "Data literal de outorga/assinatura se explícita; caso contrário, ''.",
      "minLength": 0,
      "maxLength": 200
    },

    "outorgantes": {
      "type": "array",
      "description": "Nomes literais dos outorgantes (strings).",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },

    "outorgados": {
      "type": "array",
      "description": "Nomes literais dos outorgados/procuradores (strings).",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },

    "transfere_poderes_pj": {
      "type": "boolean",
      "description": "true somente se o texto indicar explicitamente que os OUTORGANTES são PJ (CNPJ/razão social/\"pessoa jurídica\")."
    },

    "transfere_poderes_pf": {
      "type": "boolean",
      "description": "true somente se o texto indicar explicitamente que os OUTORGANTES são PF (CPF/RG/qualificação/\"pessoa física\")."
    },

    "descricao_poderes": {
      "type": "string",
      "description": "Descrição curta derivada apenas de poderes_especificos (sem adicionar poderes).",
      "minLength": 1,
      "maxLength": 6000
    },

    "poderes_especificos": {
      "type": "array",
      "description": "Lista de poderes/cláusulas (strings literais).",
      "items": { "type": "string", "minLength": 1, "maxLength": 6000 },
      "minItems": 1
    },

    "fonte": {
      "type": "object",
      "required": ["arquivo_md", "fls", "rotulo_documento"],
      "properties": {
        "arquivo_md": {
          "type": "string",
          "description": "Nome do arquivo .md de origem (basename).",
          "minLength": 1,
          "pattern": "^[^/\\\\]+\\.md$",
          "not": { "const": "collector-proc.md" }
        },
        "fls": {
          "type": "string",
          "description": "Folha/página quando explícito; senão ''.",
          "minLength": 0,
          "maxLength": 64
        },
        "rotulo_documento": {
          "type": "string",
          "description": "Rótulo descritivo quando explícito; senão ''.",
          "minLength": 0,
          "maxLength": 500
        }
      },
      "unevaluatedProperties": false
    },

    "local": {
      "type": "string",
      "description": "Local quando explícito; senão ''.",
      "minLength": 0,
      "maxLength": 200
    },

    "restricoes_ou_limitacoes": {
      "type": "array",
      "description": "Restrições/limitações explícitas.",
      "items": { "type": "string", "minLength": 1, "maxLength": 6000 }
    },

    "assinantes": {
      "type": "array",
      "description": "Assinantes nominados quando explícitos.",
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    }
  },
  "unevaluatedProperties": false
}
