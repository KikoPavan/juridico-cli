{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jus-Diagnose IRAC Output Schema",
  "description": "Schema de validação para output da skill Jus-Diagnose (método IRAC)",
  "type": "object",
  "required": ["skill", "versao", "metadados", "irac", "qualidade"],
  "additionalProperties": false,
  "properties": {
    "skill": {
      "type": "string",
      "const": "jus-diagnose"
    },
    "versao": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "example": "1.0.0"
    },
    "metadados": {
      "type": "object",
      "required": ["tipo_peca", "ramo_direito", "issues_multiplas"],
      "additionalProperties": false,
      "properties": {
        "tipo_peca": {
          "type": "string",
          "enum": [
            "PETICAO_INICIAL", "CONTESTACAO", "RECURSO", "SENTENCA",
            "ACORDAO", "CONTRATO", "EMENTA", "PARECER",
            "ENUNCIADO_EXAME", "OUTROS"
          ]
        },
        "ramo_direito": {
          "type": "string",
          "enum": [
            "CIVIL", "PROCESSO_CIVIL", "PENAL", "PROCESSO_PENAL",
            "TRABALHISTA", "TRIBUTARIO", "ADMINISTRATIVO", "CONSTITUCIONAL",
            "EMPRESARIAL", "CONSUMIDOR", "IMOBILIARIO", "SUCESSOES",
            "FAMILIA", "OUTROS"
          ]
        },
        "partes": {
          "type": ["object", "null"],
          "properties": {
            "polo_ativo": { "type": "string" },
            "polo_passivo": { "type": "string" }
          }
        },
        "tribunal_juizo": {
          "type": ["string", "null"]
        },
        "data_peca": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "issues_multiplas": {
          "type": "boolean"
        }
      }
    },
    "irac": {
      "type": "object",
      "required": ["issue", "rule", "application", "conclusion"],
      "additionalProperties": false,
      "properties": {
        "issue": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "questao", "prejudicial"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^I-\\d{2}$"
              },
              "questao": {
                "type": "string",
                "minLength": 10,
                "maxLength": 500
              },
              "prejudicial": {
                "type": "boolean"
              }
            }
          }
        },
        "rule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "diploma", "artigo", "enunciado", "hierarquia", "issue_ref"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^R-\\d{2}$"
              },
              "diploma": {
                "type": "string"
              },
              "artigo": {
                "type": "string"
              },
              "enunciado": {
                "type": "string",
                "maxLength": 200
              },
              "hierarquia": {
                "type": "string",
                "enum": [
                  "CF", "LEI_FEDERAL", "LEI_COMPLEMENTAR", "LEI_ESTADUAL",
                  "LEI_MUNICIPAL", "REGULAMENTO", "SUMULA_VINCULANTE",
                  "SUMULA", "TESE_REPERCUSSAO", "ENUNCIADO_FONAJE"
                ]
              },
              "issue_ref": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "application": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "fato", "elemento_norma", "rule_ref", "status"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^A-\\d{2}$"
              },
              "fato": {
                "type": "string"
              },
              "elemento_norma": {
                "type": "string"
              },
              "rule_ref": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["PRESENTE", "AUSENTE", "PARCIAL", "CONTROVERSO"]
              }
            }
          }
        },
        "conclusion": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "issue_ref", "resposta", "fundamento"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^C-\\d{2}$"
              },
              "issue_ref": {
                "type": "string"
              },
              "resposta": {
                "type": "string",
                "enum": ["SIM", "NAO", "CONDICIONAL", "INCONCLUSIVO"]
              },
              "fundamento": {
                "type": "string",
                "minLength": 10
              },
              "condicao": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    },
    "qualidade": {
      "type": "object",
      "required": ["confianca", "limitacoes"],
      "additionalProperties": false,
      "properties": {
        "confianca": {
          "type": "string",
          "enum": ["ALTA", "MEDIA", "BAIXA"]
        },
        "limitacoes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recomendacao": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
