{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juridico-cli.local/agents/law-cli/io.schema.json",
  "title": "law-cli — law_pack_v1.json (Envelope + Payload) — v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_name",
    "agent_version",
    "job_id",
    "run_id",
    "created_at",
    "status",
    "inputs",
    "payload"
  ],
  "properties": {
    "agent_name": { "const": "law-cli" },
    "agent_version": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },

    "status": { "type": "string", "enum": ["ok", "partial", "failed"] },

    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processo", "qdrant"],
      "properties": {
        "processo": { "$ref": "#/$defs/input_ref" },
        "qdrant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "collection"],
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "collection": { "type": "string", "minLength": 1 }
          }
        }
      }
    },

    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },

    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "effective_date", "queries", "rules"],
      "properties": {
        "schema_version": { "const": "law_pack_v1" },

        "effective_date": {
          "description": "Data efetiva do ato/negócio (ISO-8601). Se desconhecida, null + gap correspondente.",
          "type": ["string", "null"],
          "format": "date"
        },

        "effective_date_evidence": {
          "description": "Referência rastreável para a effective_date (se houver).",
          "anyOf": [
            { "$ref": "#/$defs/evidence_ref" },
            { "type": "null" }
          ]
        },

        "queries": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },

        "topics": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 }
        },

        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rule_item" }
        },

        "gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/gap_item" }
        }
      }
    }
  },

  "$defs": {
    "input_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },

    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "anchor": { "type": "string" },
        "excerpt": { "type": "string" },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "doc_id": { "type": "string" },
            "path": { "type": "string" },
            "page": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "anyOf": [{ "required": ["anchor"] }, { "required": ["locator"] }]
    },

    "rule_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "text", "support", "score"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 64 },
        "title": { "type": "string", "minLength": 3 },
        "citation": { "type": "string" },
        "text": { "type": "string", "minLength": 10 },

        "valid_from": { "type": ["string", "null"], "format": "date" },
        "valid_to": { "type": ["string", "null"], "format": "date" },

        "score": { "type": "number" },

        "support": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_ref" }
        },

        "meta": { "type": "object" }
      }
    },

    "gap_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "text": { "type": "string", "minLength": 5 }
      }
    }
  }
}
