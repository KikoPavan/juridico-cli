# infra/env/.env.example
# Variáveis de ambiente — juridico-cli
# Copie este arquivo para infra/env/.env e preencha os valores reais.
# NUNCA commite o arquivo .env com valores reais.
#
# Uso — apenas Qdrant (padrão):
#   docker compose --env-file infra/env/.env -f infra/docker/docker-compose.yml up -d
#
# Uso — Qdrant + llama.cpp (requer LLAMA_MODELS_PATH preenchido e .gguf baixado):
#   docker compose --env-file infra/env/.env -f infra/docker/docker-compose.yml --profile local-llm up -d

# ---------------------------------------------------------------------------
# Gemini API (LLM remoto)
# Obtenha em: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# llama.cpp local (Docker Desktop)
# LLAMA_MODELS_PATH: caminho absoluto no host onde estão os arquivos .gguf.
#   Use sempre o formato Linux/WSL2 — Docker Desktop mapeia automaticamente.
#   Exemplos:
#     WSL2 (recomendado):   /home/<usuario>/models
#     Windows via WSL2:     /mnt/c/Users/<usuario>/models
#   NUNCA use C:\... — esse formato não funciona quando o script roda no WSL2.
# LLAMA_MODEL_FILE: nome do arquivo .gguf dentro de LLAMA_MODELS_PATH.
#   Modelo canônico: llama-3.2-3b-instruct.gguf
#   Variante recomendada para hardware consumer: Llama-3.2-3B-Instruct-Q4_K_M.gguf
#   Download: https://huggingface.co/bartowski/Llama-3.2-3B-Instruct-GGUF
# LLAMA_HOST: endpoint interno usado pelo runtime Python para chamar o serviço.
# ---------------------------------------------------------------------------
LLAMA_MODELS_PATH=/home/<usuario>/models
LLAMA_MODEL_FILE=llama-3.2-3b-instruct.gguf
LLAMA_HOST=http://host.docker.internal:1234
LLAMA_CPP_ENDPOINT=http://host.docker.internal:1234
LLAMA_MODEL=qwen2.5-1.5b-instruct
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=lm-studio
LLM_FAST_MODEL=qwen2.5-1.5b-instruct
LLM_REASONING_MODEL=meta-llama-3.1-8b-instruct@q4_k_m
LLM_LONG_CONTEXT_MODEL=gemma-4-26b-a4b-it
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# ---------------------------------------------------------------------------
# Qdrant local (Docker Desktop)
# QDRANT_HOST: endpoint interno usado pelo runtime Python para indexar e buscar.
# ---------------------------------------------------------------------------
QDRANT_HOST=http://localhost:6333
